# === NewsEngine 配置模板 ===
# 
# 请复制此文件为 .env 并填入实际值
# 
# 注意：
# - 敏感信息（如 API 密钥）必须替换为实际值
# - 非敏感信息可以使用默认值，也可根据需要修改
# - 此文件不包含敏感信息，可提交到版本控制系统

# === OpenAI 兼容接口 (LLM + Embedding；百炼 / 本地通用) ===
# 敏感: 是
# 默认: —
# 必填: 是
# 说明: OpenAI 兼容接口 API Key（百炼 DashScope 或本地 llama-server，后者任意非空值）
OPENAI_API_KEY=sk-***

# 敏感: 否
# 默认: https://dashscope.aliyuncs.com/compatible-mode/v1
# 必填: 否
# 说明: OpenAI 兼容 Base URL；本地推理指到 http://127.0.0.1:8080/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 敏感: 否
# 默认: text-embedding-v4
# 必填: 否
# 说明: Embedding 模型名
EMBEDDING_MODEL=text-embedding-v4

# === Embedding 服务（独立于 LLM，百炼 DashScope） ===
# LLM 切到 local 时，embedding 仍走百炼（llama-server 不提供 embedding 端点）

# 敏感: 否
# 默认: https://dashscope.aliyuncs.com/compatible-mode/v1
# 必填: 否（有默认值）
# 说明: Embedding 服务 Base URL（独立于 LLM 的 OPENAI_BASE_URL）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 敏感: 是（百炼真实 API Key，勿提交到仓库）
# 默认: （空，为空时自动 fallback 到 OPENAI_API_KEY）
# 必填: 否（仅当 OPENAI_BASE_URL 指向本地且 OPENAI_API_KEY 非法时必填）
# 说明: Embedding 服务 API Key（百炼 DashScope）。为空时 fallback 到 OPENAI_API_KEY
EMBEDDING_API_KEY=

# 敏感: 否
# 默认: qwen3.7-plus
# 必填: 否
# 说明: LLM 模型名（百炼：qwen3.7-plus；本地：如 gemma4-12b）
LLM_MODEL=qwen3.7-plus

# === Graphiti LLM Provider ===
# 敏感: 否
# 默认: gemini
# 必填: 否
# 说明: gemini（原生 Gemini API，免费不稳定）| openai（百炼，稳定收费）|
#       local（本地 llama-server，零成本吞吐受限）
GRAPHITI_LLM_PROVIDER=gemini

# === Graphiti 并发控制 ===
# 敏感: 否
# 默认: 3
# 必填: 否
# 说明: Episode 级并发（_LLM_SEMAPHORE）。API 推荐 3-5，Local 推荐 1
EPISODE_SEMAPHORE=3

# 敏感: 否
# 默认: 3
# 必填: 否
# 说明: graphiti-core 内部并发（max_coroutines）。Gemini 免费档 1-3，
#       百炼/本地 3-10
SEMAPHORE_LIMIT=3

# === 429 熔断/退避参数 ===
# 敏感: 否
# 默认: 3
# 必填: 否
# 说明: 连续 N 次 429 触发熔断。Gemini 推荐 3；Local 不会触发 429
CIRCUIT_MAX_CONSECUTIVE_429=3

# 敏感: 否
# 默认: 60.0
# 必填: 否
# 说明: 熔断冷却时间（秒）。Gemini 推荐 60（配额窗口约 1min）
CIRCUIT_COOLDOWN_SEC=60

# 敏感: 否
# 默认: 37.0
# 必填: 否
# 说明: 429 退避下限（秒）。Gemini retryDelay 官方下限 37s
MIN_429_BACKOFF_SEC=37

# === DeepSeek API (LLM) ===
# 敏感: 是
# 默认: —
# 必填: 是
# 说明: DeepSeek API Key，用于 LLM 客户端（取代百炼 LLM）
DEEPSEEK_API_KEY=sk-***

# 敏感: 否
# 默认: https://api.deepseek.com
# 必填: 否
# 说明: DeepSeek API Base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 敏感: 否
# 默认: deepseek-chat
# 必填: 否
# 说明: DeepSeek 模型名
DEEPSEEK_MODEL=deepseek-chat

# === Neo4j 连接 ===
# 敏感: 否
# 默认: bolt://localhost:7687
# 必填: 否
# 说明: Neo4j Bolt URI
NEO4J_URI=bolt://localhost:7687

# 敏感: 否
# 默认: neo4j
# 必填: 否
# 说明: Neo4j 用户名
NEO4J_USER=neo4j

# 敏感: 否
# 默认: newsengine2026
# 必填: 否
# 说明: Neo4j 密码（开发环境默认值，非敏感）
NEO4J_PASSWORD=newsengine2026

# === FastAPI 服务 ===
# 敏感: 否
# 默认: 0.0.0.0
# 必填: 否
# 说明: FastAPI 监听地址
API_HOST=0.0.0.0

# 敏感: 否
# 默认: 8100
# 必填: 否
# 说明: FastAPI 监听端口
API_PORT=8100

# === SynapseEngine 连接 ===
# 敏感: 否
# 默认: http://localhost:8000
# 必填: 否
# 说明: SynapseEngine REST API 地址
SYNAPSE_BASE_URL=http://localhost:8000

# 敏感: 否
# 默认: data/ticker_whitelist.json
# 必填: 否
# 说明: Ticker 白名单本地缓存文件路径
TICKER_WHITELIST_FILE=data/ticker_whitelist.json

# === 日志 ===
# 敏感: 否
# 默认: INFO
# 必填: 否
# 说明: 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 敏感: 否
# 默认: logs/news_engine.log
# 必填: 否
# 说明: 日志文件路径
LOG_FILE=logs/news_engine.log

# === 数据摄取 ===
# 敏感: 否
# 默认: 900
# 必填: 否
# 说明: 多 Tier 调度下为 Tier 1（实时/高频：GDELT/RSS/CLS/EastMoney/AKShare）轮询间隔（秒）
INGESTION_INTERVAL_SEC=900

# 敏感: 否
# 默认: 14400
# 必填: 否
# 说明: Tier 2（日频：CNInfo/Treasury/FRED）轮询间隔（秒）
INGESTION_TIER2_INTERVAL_SEC=14400

# 敏感: 否
# 默认: 43200
# 必填: 否
# 说明: Tier 3（周频：EIA/ACLED/Sanctions）轮询间隔（秒）
INGESTION_TIER3_INTERVAL_SEC=43200

# 敏感: 否
# 默认: 86400
# 必填: 否
# 说明: Tier 4（月/季频：BLS/ChinaMacro/EMResearch）轮询间隔（秒）
INGESTION_TIER4_INTERVAL_SEC=86400

# === GDELT ===
# 敏感: 否
# 默认: http://data.gdeltproject.org/gdeltv2/lastupdate.txt
# 必填: 否
# 说明: GDELT V2 lastupdate.txt URL
GDELT_LASTUPDATE_URL=http://data.gdeltproject.org/gdeltv2/lastupdate.txt

# 敏感: 否
# 默认: 3
# 必填: 否
# 说明: GDELT 下载重试次数
GDELT_MAX_RETRIES=3

# 敏感: 否
# 默认: 60
# 必填: 否
# 说明: GDELT HTTP 超时（秒）
GDELT_TIMEOUT_SEC=60

# === RSS ===
# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: RSS HTTP 超时（秒）
RSS_TIMEOUT_SEC=30

# === AkShare ===
# 敏感: 否
# 默认: 0.5
# 必填: 否
# 说明: AkShare 查询间隔（秒）
AKSHARE_REQUEST_INTERVAL_SEC=0.5

# === Risk Summary 缓存 ===
# 敏感: 否
# 默认: 300
# 必填: 否
# 说明: Risk Summary 缓存 TTL（秒）
RISK_SUMMARY_CACHE_TTL_SEC=300

# === 宏观数据源认证 (Phase 1, add-phase1-macro-adapters) ===
# FRED / EIA 需免费注册 API key；ACLED 需注册 myACLED 账号（OAuth2 用户名+密码）；未配置时对应 adapter 优雅降级（fetch 返回空列表 + warning）。
# OFAC SDN / OpenSanctions / BLS 无需 API key。

# 敏感: 是
# 默认: 空
# 必填: 否
# 说明: FRED API Key（免费注册 https://fred.stlouisfed.org/docs/api/api_key.html），空则跳过 FRED
FRED_API_KEY=

# 敏感: 是
# 默认: 空
# 必填: 否
# 说明: ACLED 用户名（注册邮箱），空则跳过 ACLED（OAuth2 认证）
ACLED_USERNAME=

# 敏感: 是
# 默认: 空
# 必填: 否
# 说明: ACLED 密码（与 ACLED_USERNAME 配套），空则跳过 ACLED（OAuth2 认证）
ACLED_PASSWORD=

# 敏感: 是
# 默认: 空
# 必填: 否
# 说明: EIA API Key（免费注册 https://www.eia.gov/opendata/register.php），空则跳过 EIA
EIA_API_KEY=

# === 宏观数据源超时 (Phase 1, add-phase1-macro-adapters) ===
# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: FRED HTTP 超时（秒）
FRED_TIMEOUT_SEC=30

# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: ACLED HTTP 超时（秒）
ACLED_TIMEOUT_SEC=30

# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: EIA HTTP 超时（秒）
EIA_TIMEOUT_SEC=30

# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: BLS HTTP 超时（秒）
BLS_TIMEOUT_SEC=30

# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: OpenSanctions/OFAC HTTP 超时（秒）
OPEN_SANCTIONS_TIMEOUT_SEC=30

# 敏感: 是
# 默认: 无
# 必填: 否（未配置时跳过 OpenSanctions，直接使用 OFAC SDN）
# 说明: OpenSanctions API key（付费）。获取: https://www.opensanctions.org/pricing/
OPEN_SANCTIONS_API_KEY=


# === 新闻时效窗口 ===
# 敏感: 否
# 默认: 14
# 必填: 否
# 说明: 全局新闻时效窗口（天）— 适用于日频/周频数据源（GDELT、RSS、EIA、CLS 等）
# 注意：BLS（月度就业数据）和 FRED（月度/季度宏观数据）使用独立的 90 天窗口，不受此配置影响
NEWS_MAX_AGE_DAYS=14
# === 备注 ===
# - GRAPITI_LLM_PROVIDER 和 GRAPITI_EMBEDDING_PROVIDER 已废弃
#   Graphiti SDK 配置现在通过代码中的 create_graphiti() 函数直接设置