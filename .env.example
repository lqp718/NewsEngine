# === NewsEngine 配置模板 ===
# 
# 请复制此文件为 .env 并填入实际值
# 
# 注意：
# - 敏感信息（如 API 密钥）必须替换为实际值
# - 非敏感信息可以使用默认值，也可根据需要修改
# - 此文件不包含敏感信息，可提交到版本控制系统

# === 阿里百炼 API (LLM + Embedding) ===
# 敏感: 是
# 默认: —
# 必填: 是
# 说明: 阿里百炼 API Key，用于访问 LLM 和 Embedding 服务
BAILIAN_API_KEY=sk-***

# 敏感: 否
# 默认: https://dashscope.aliyuncs.com/compatible-mode/v1
# 必填: 否
# 说明: 百炼 OpenAI 兼容 Base URL
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 敏感: 否
# 默认: text-embedding-v4
# 必填: 否
# 说明: 百炼 Embedding 模型名
EMBEDDING_MODEL=text-embedding-v4

# 敏感: 否
# 默认: qwen3.7-plus
# 必填: 否
# 说明: 百炼 LLM 模型名
LLM_MODEL=qwen3.7-plus

# === Neo4j 连接 ===
# 敏感: 否
# 默认: bolt://localhost:7687
# 必填: 否
# 说明: Neo4j Bolt URI
NEO4J_URI=bolt://localhost:7687

# 敏感: 否
# 默认: neo4j
# 必填: 否
# 说明: Neo4j 用户名
NEO4J_USER=neo4j

# 敏感: 否
# 默认: newsengine2026
# 必填: 否
# 说明: Neo4j 密码（开发环境默认值，非敏感）
NEO4J_PASSWORD=newsengine2026

# === FastAPI 服务 ===
# 敏感: 否
# 默认: 0.0.0.0
# 必填: 否
# 说明: FastAPI 监听地址
API_HOST=0.0.0.0

# 敏感: 否
# 默认: 8100
# 必填: 否
# 说明: FastAPI 监听端口
API_PORT=8100

# === SynapseEngine 连接 ===
# 敏感: 否
# 默认: http://localhost:8000
# 必填: 否
# 说明: SynapseEngine REST API 地址
SYNAPSE_BASE_URL=http://localhost:8000

# 敏感: 否
# 默认: data/ticker_whitelist.json
# 必填: 否
# 说明: Ticker 白名单本地缓存文件路径
TICKER_WHITELIST_FILE=data/ticker_whitelist.json

# === 日志 ===
# 敏感: 否
# 默认: INFO
# 必填: 否
# 说明: 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 敏感: 否
# 默认: logs/news_engine.log
# 必填: 否
# 说明: 日志文件路径
LOG_FILE=logs/news_engine.log

# === 数据摄取 ===
# 敏感: 否
# 默认: 900
# 必填: 否
# 说明: 数据源轮询间隔（秒）
INGESTION_INTERVAL_SEC=900

# === GDELT ===
# 敏感: 否
# 默认: http://data.gdeltproject.org/gdeltv2/lastupdate.txt
# 必填: 否
# 说明: GDELT V2 lastupdate.txt URL
GDELT_LASTUPDATE_URL=http://data.gdeltproject.org/gdeltv2/lastupdate.txt

# 敏感: 否
# 默认: 3
# 必填: 否
# 说明: GDELT 下载重试次数
GDELT_MAX_RETRIES=3

# 敏感: 否
# 默认: 60
# 必填: 否
# 说明: GDELT HTTP 超时（秒）
GDELT_TIMEOUT_SEC=60

# === RSS ===
# 敏感: 否
# 默认: 30
# 必填: 否
# 说明: RSS HTTP 超时（秒）
RSS_TIMEOUT_SEC=30

# === AkShare ===
# 敏感: 否
# 默认: 0.5
# 必填: 否
# 说明: AkShare 查询间隔（秒）
AKSHARE_REQUEST_INTERVAL_SEC=0.5

# === Risk Summary 缓存 ===
# 敏感: 否
# 默认: 300
# 必填: 否
# 说明: Risk Summary 缓存 TTL（秒）
RISK_SUMMARY_CACHE_TTL_SEC=300

# === 备注 ===
# - GRAPITI_LLM_PROVIDER 和 GRAPITI_EMBEDDING_PROVIDER 已废弃
#   Graphiti SDK 配置现在通过代码中的 create_graphiti() 函数直接设置